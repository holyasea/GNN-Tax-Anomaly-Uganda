# ============================================================
# .gitignore for GNN Tax Anomaly Detection (Uganda EFRIS)
# ============================================================

# --- 1. Ignore All Unrelated Files & Folders in the Root ---
/*
!/.gitignore
!/README.md
!/LICENSE
!/data/
!/paper/

# --- 2. Confidential & Heavy Raw Data Files in data/ ---
**/*.csv
!data/auditor_review_blinded.csv
!data/case_cards_consensus_flagged.csv
!data/case_cards_control_matched.csv
!data/injection_benchmark_summary.csv
!data/robustness_contamination.csv
!data/rule_baseline_zero_sales.csv
!data/feature_importance_summary.csv
!data/score_degree_correlation.csv
!data/seed_stability.csv
!data/temporal_analysis.csv
!data/policy_revenue_at_risk.csv
!data/model_comparison_actual.json

# --- 3. Heavy Binary Data, Chunks, and Embeddings ---
**/*.RData*
**/*.rdata*
**/*.npy
**/*.pt
**/*.dta
**/*.xlsx
**/*.xls
**/*.db
**/*.tar.gz
**/*.zip
**/Sales_Chunk/
**/_stale/

# --- 4. Python, R, and IDE Caches ---
**/.Rhistory
**/.Rproj.user/
**/__pycache__/
**/*.pyc
**/.posit/

# --- 5. LaTeX Build Artifacts ---
paper/*.aux
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.blg
paper/*.toc
paper/*.lof
paper/*.lot

# Keep deliverables in paper/
!paper/main.pdf
!paper/*.docx
